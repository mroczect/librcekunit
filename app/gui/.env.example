# === Binary ===
CEKUNIT_BIN=cekunit

# === Server ===
LIBRCEKUNIT_BASE_URL=http://103.31.38.200
LIBRCEKUNIT_EMAIL=user@example.com
LIBRCEKUNIT_PASSWORD=secret
LIBRCEKUNIT_COOKIE_FILE=session.json
LIBRCEKUNIT_TIMEOUT_SECS=1800

# === Logging ===
CEKUNIT_LOG=info

# === Safety ===
# 0 = read-only (write ditolak)
# 1 = write diizinkan (masih perlu --execute + konfirmasi)
CEKUNIT_ALLOW_WRITE=0

# === GUI ===
CEKUNIT_GUI_LOG=cekunit_gui.log
CEKUNIT_GUI_PREFS=prefs.json
