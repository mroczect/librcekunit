# =============================================================================
# librcekunit environment variables
# =============================================================================
#
# Copy this file to `.env` and edit the values:
#
#     cp .env.example .env
#     $EDITOR .env
#
# Load it into your shell before running any binary:
#
#     set -a && . ./.env && set +a
#
# Or, one-off:
#
#     env $(grep -v '^#' .env | xargs) cargo run ...
#
# Every variable is optional at the shell level. Which ones are required
# depends on which binary you run. See `librcekunit_examples/examples/`
# for concrete usage.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Root URL of the Cek Unit Laravel backend. No trailing slash.
# Required by every binary that talks to the server.
LIBRCEKUNIT_BASE_URL=http://your_server

# Request timeout in seconds. Parsed as u64. Defaults to 30.
# Set to 0 to disable the timeout entirely (not recommended).
# LIBRCEKUNIT_TIMEOUT_SECS=30

# User agent header value. Defaults to "librcekunit/3.0".
# LIBRCEKUNIT_USER_AGENT=librcekunit/3.0


# -----------------------------------------------------------------------------
# Cookies
# -----------------------------------------------------------------------------

# Path to a JSON file used to persist cookies between runs.
# When set, cookies are written after every request and reloaded at
# construction. Delete the file to force a fresh login.
#
LIBRCEKUNIT_COOKIE_FILE=session.json

# -----------------------------------------------------------------------------
# Credentials
# -----------------------------------------------------------------------------

# Login email. Required by every example that calls login.
LIBRCEKUNIT_EMAIL=user@example.com

# Login password. Required by every example that calls login.
LIBRCEKUNIT_PASSWORD=secret


# -----------------------------------------------------------------------------
# Tracing
# -----------------------------------------------------------------------------

# Tracing filter. When unset, the examples fall back to "info".
#
# Common values:
#   info                                      - example-level progress only
#   librcekunit_api=debug                     - per-request HTTP logs
#   librcekunit_api=debug,librcekunit_examples=info
#                                             - HTTP logs plus progress
#   debug                                     - everything, including deps
#   warn                                      - quiet
#
# RUST_LOG=info


# -----------------------------------------------------------------------------
# Proxy (read automatically by reqwest)
# -----------------------------------------------------------------------------

# Standard proxy variables. Uncomment to route traffic through a proxy.
# Both HTTP and HTTPS are supported. Credentials can be embedded in the
# URL when the proxy requires authentication.
#
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal


# -----------------------------------------------------------------------------
# Per-crate reference
# -----------------------------------------------------------------------------
#
# librcekunit_handler
#   No environment variables. Pure contracts.
#
# librcekunit_api
#   Uses `librcekunit_handler::Config` directly. Does not read the
#   environment itself; the caller supplies a `Config`.
#
# librcekunit_client
#   Reads all `LIBRCEKUNIT_*` variables listed above through
#   `librcekunit_client::env::from_env` and
#   `librcekunit_client::env::login_from_env`.
#
# librcekunit_examples
#   Reads all `LIBRCEKUNIT_*` variables plus `RUST_LOG`.
#
# =============================================================================
