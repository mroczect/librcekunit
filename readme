=============================================================================
1. INSTALLATION
=============================================================================

Since the library is NOT published on crates.io, add it as a Git dependency:

  [dependencies]
  librcekunit = { git = "https://codeberg.org/mroczect/librcekunit.git", tag = "v2.1.0" }
  tokio = { version = "1", features = ["full"] }

Or use a specific commit:

  librcekunit = { git = "https://codeberg.org/mroczect/librcekunit.git", rev = "abc123" }

For local development:

  librcekunit = { path = "../librcekunit" }

Then run `cargo build`. The library requires `tokio` runtime – annotate your
`main` with `#[tokio::main]`.


=============================================================================
2. FEATURES OVERVIEW
=============================================================================

+--------------------------+---------------------------------------------------+
| Feature                  | Description                                       |
+--------------------------+---------------------------------------------------+
| Automatic CSRF handling  | Extracts tokens from HTML and injects into POST  |
| Cookie persistence       | In‑memory or file‑based (JSON) storage           |
| Async by default         | Built on reqwest and tokio                       |
| Strong error types       | Comprehensive Error enum                         |
| Builder‑style config     | Config struct with chainable setters             |
| Full endpoint coverage   | cekunit, dashboard, input data, PIC, users       |
| Export/Import            | Bulk data export (CSV/JSON) and import           |
| Bulk delete              | Delete all or by category column                 |
| Structured logging       | Tracing instrumentation, RUST_LOG controllable   |
| No unsafe code           | Safe Rust (except env::set_var in examples)      |


=============================================================================
3. QUICK START
=============================================================================

  use librcekunit::{Client, Config};

  #[tokio::main]
  async fn main() -> Result<(), Box<dyn std::error::Error>> {
      librcekunit::init_tracing();

      let config = Config::new("https://admin.example.com")
          .with_timeout(60)
          .with_user_agent("my-app/2.0");
      let client = Client::new(config).await?;

      client.login("user@example.com", "password").await?;
      let dashboard = client.dashboard_index().await?;
      println!("Status: {}", dashboard.status());

      client.logout().await?;
      Ok(())
  }


=============================================================================
4. CONFIGURATION
=============================================================================

4.1 Struct Config (src/config.rs)

Fields:

  Field         | Type         | Default                     | Description
  --------------|--------------|-----------------------------|----------------------------------------
  base_url      | String       | (required)                  | API root URL (trailing slash trimmed)
  timeout       | Duration     | 30 seconds                  | Per‑request timeout
  user_agent    | String       | "librcekunit/2.0"           | User‑Agent header
  cookie_store  | CookieStore  | Persistent("librcekunit_cookies.json") | Cookie persistence policy

Constructors:

  • Config::new(base_url: &str) -> Self
  • Config::from_env() -> Result<Self, Error>   (reads BASE_URL from env/.env)

Builder methods:

  • .with_timeout(secs: u64) -> Self
  • .with_user_agent(ua: &str) -> Self
  • .with_cookie_store(store: CookieStore) -> Self

Example:

  let config = Config::new("https://api.example.com")
      .with_timeout(120)
      .with_user_agent("MyApp/1.0")
      .with_cookie_store(CookieStore::Memory);

4.2 Enum CookieStore

  Variant        | Behaviour
  ----------------|-----------------------------------------------------------
  None            | No persistence – cookies lost when Client is dropped.
  Memory          | Keep cookies only in memory (process lifetime).
  Persistent(PathBuf) | Save to/load from given JSON file on every request.


=============================================================================
5. HIGH‑LEVEL CLIENT (Client)
=============================================================================

The `Client` struct is the recommended entry point. It wraps `HttpClient`
and provides convenience methods for all endpoints.

5.1 Constructor

  async fn new(config: Config) -> Result<Self, Error>

5.2 Authentication

  async fn login(&self, email: &str, password: &str) -> Result<(), Error>
  async fn logout(&self) -> Result<(), Error>

5.3 Dashboard

  Method                                   | HTTP  | Path
  -----------------------------------------|-------|----------------------
  dashboard_index()                        | GET   | /dashboard
  dashboard_index_with_params(params)      | GET   | /dashboard?key=val...

5.4 CRUD (cekunit)

  Method                                   | HTTP                | Path
  -----------------------------------------|---------------------|----------------------------
  cekunit_index()                          | GET                 | /cekunit
  cekunit_index_with_params(params)        | GET                 | /cekunit?...
  cekunit_create()                         | GET                 | /cekunit/create
  cekunit_store(data)                      | POST                | /cekunit
  cekunit_show(no)                         | GET                 | /cekunit/{no}
  cekunit_edit(no)                         | GET                 | /cekunit/{no}/edit
  cekunit_update(no, data)                 | POST (with _method=PUT) | /cekunit/{no}
  cekunit_destroy(no)                      | POST (with _method=DELETE) | /cekunit/{no}

5.5 Bulk Operations

  Method                                   | Description
  -----------------------------------------|----------------------------------------------
  dashboard_delete_all()                   | Delete ALL entries (irreversible)
  cekunit_delete_by_category(column, value)| Delete rows where column == value
  cekunit_export(format, sort, direction)  | Export data (csv/json/xlsx)
  cekunit_get_unique_values(column)        | Get distinct values of a column

5.6 Input User (full CRUD + export/import)

  Method                                   | Path
  -----------------------------------------|----------------------------------------
  input_user_index()                       | GET /dashboard/input-user
  input_user_index_with_params(params)     | GET /dashboard/input-user?...
  input_user_create()                      | GET /dashboard/input_user/create
  input_user_store(data)                   | POST /dashboard/input_user
  input_user_show(id)                      | GET /dashboard/input_user/{id}
  input_user_edit(id)                      | GET /dashboard/input_user/{id}/edit
  input_user_update(id, data)              | POST /dashboard/input_user/{id} (with _method=PUT)
  input_user_destroy(id)                   | POST /dashboard/input_user/{id} (with _method=DELETE)
  input_user_export(params)                | GET /dashboard/input_user/export
  input_user_import(data)                  | POST /dashboard/input_user/insert

5.7 Input Data

  Method                                   | Path
  -----------------------------------------|----------------------------------------
  input_data_create()                      | GET /dashboard/input-data
  input_data_store(data)                   | POST /dashboard/input-data

5.8 PIC (Person In Charge)

  Method                                   | Path
  -----------------------------------------|----------------------------------------
  pic_index()                              | GET /pic
  pic_index_with_params(params)            | GET /pic?...
  pic_create()                             | GET /pic/create
  pic_store(data)                          | POST /pic
  pic_show(nomor)                          | GET /pic/{nomor}
  pic_edit(nomor)                          | GET /pic/{nomor}/edit
  pic_update(nomor, data)                  | POST /pic/{nomor} (with _method=PUT)
  pic_destroy(nomor)                       | POST /pic/{nomor} (with _method=DELETE)
  dashboard_pic_index()                    | GET /dashboard/pic
  dashboard_pic_index_with_params(params)  | GET /dashboard/pic?...
  input_pic_create()                       | GET /dashboard/input-PIC
  input_pic_store(data)                    | POST /dashboard/input-PIC

5.9 Users

  Method                                   | Path
  -----------------------------------------|----------------------------------------
  users_index()                            | GET /users
  users_index_with_params(params)          | GET /users?...
  users_create()                           | GET /users/create
  users_store(data)                        | POST /users
  users_show(nomor)                        | GET /users/{nomor}
  users_edit(nomor)                        | GET /users/{nomor}/edit
  users_update(nomor, data)                | POST /users/{nomor} (with _method=PUT)
  users_destroy(nomor)                     | POST /users/{nomor} (with _method=DELETE)
  dashboard_users_index()                  | GET /dashboard/users
  dashboard_users_index_with_params(params)| GET /dashboard/users?...

5.10 Low‑Level Request

  async fn request(&self, method: HttpMethod, path: &str,
                   body: Option<HashMap<String, String>>)
                   -> Result<reqwest::Response, Error>

  For GET/HEAD: `body` becomes query parameters.
  For others: `body` becomes form data (CSRF token auto‑injected).

5.11 Accessing Inner HttpClient

  fn http(&self) -> &HttpClient


=============================================================================
6. LOW‑LEVEL HTTP CLIENT (HttpClient)
=============================================================================

The `HttpClient` struct (obtainable via `client.http()` or constructed directly)
provides fine‑grained control.

Creating standalone:

  use librcekunit::http_client::HttpClient;
  let client = HttpClient::new(&config).await?;

Key methods (all async where noted):

  • fn base_url(&self) -> &str
  • fn cookie_jar(&self) -> &Arc<Jar>
  • async fn fetch_csrf_token(&self, url: &str) -> Result<String, Error>
  • fn parse_csrf_from_html(html: &str) -> Result<String, Error>
  • async fn set_csrf_token(&self, token: String)
  • async fn get_csrf_token(&self) -> Option<String>
  • async fn request(...) -> Result<reqwest::Response, Error>
  • async fn clear_session(&self)
  • async fn reset_csrf_token(&self)

Note: `fetch_csrf_token` sends a GET request to the given path, parses the HTML
for `<input name="_token" value="...">`, stores the token, and returns it.
`clear_session` deletes the persistent cookie file and resets the CSRF token.


=============================================================================
7. ERROR HANDLING (Enum Error)
=============================================================================

All functions return `Result<T, librcekunit::Error>`.

Variant            | Description
-------------------|--------------------------------------------------------
Config(String)     | Missing/invalid configuration (e.g., BASE_URL not set)
Reqwest(reqwest::Error) | Network/HTTP error
Io(std::io::Error) | Filesystem I/O error (cookie file)
Json(serde_json::Error) | JSON serialization/deserialization error
Auth(String)       | Authentication failure (wrong credentials)
Api(u16, String)   | Server returned HTTP error (status code + message snippet)
CsrfNotFound       | CSRF token missing in HTML response
NotLoggedIn        | Protected endpoint accessed without login
CookieStore(String)| Cookie storage error (e.g., invalid path)

Example:

  match client.login("user@x.com", "pwd").await {
      Ok(()) => { /* success */ }
      Err(Error::Auth(msg)) => eprintln!("Auth error: {}", msg),
      Err(Error::Api(status, body)) => eprintln!("HTTP {status}: {body}"),
      Err(e) => eprintln!("Other: {}", e),
  }


=============================================================================
8. TYPES & UTILITIES
=============================================================================

8.1 HttpMethod (enum)

  Variants: GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS

  Methods:
    • fn as_str(&self) -> &'static str
    • Implements Display (to_string() works)

8.2 join_url(base: &str, path: &str) -> String

  Joins base URL and path, handling duplicate slashes.
  If path starts with "http", returns path unchanged.

  Example:
    join_url("https://example.com/", "api/v1") -> "https://example.com/api/v1"

8.3 ApiResponse<T> (struct)

  Generic wrapper for JSON API responses.

  Fields:
    pub status: String
    pub data: Option<T>
    pub message: Option<String>

  Implements Serialize and Deserialize (serde).


=============================================================================
9. COOKIE UTILITIES
=============================================================================

Functions to manually save/load cookies (usually handled automatically):

  use librcekunit::cookies::{save_cookies_to_file, load_cookies_from_file};
  use reqwest::cookie::Jar;
  use std::sync::Arc;
  use std::path::Path;

  let jar = Arc::new(Jar::default());
  save_cookies_to_file(&jar, "https://example.com", Path::new("cookies.json"))?;
  load_cookies_from_file(&jar, "https://example.com", Path::new("cookies.json"))?;

Both functions panic if the URL cannot be parsed (expected to be valid).


=============================================================================
10. LOGGING WITH TRACING
=============================================================================

Call `librcekunit::init_tracing()` once at the start of your program to enable
structured logging. Log level is controlled by the `RUST_LOG` environment variable.
Default is `info`. Example:

  RUST_LOG=debug cargo run
  RUST_LOG=librcekunit=trace cargo run

Sensitive fields (like `password`) are never logged.


=============================================================================
11. SECURITY CONSIDERATIONS
=============================================================================

  • Password safety: The `login` function explicitly skips the password field
    in tracing spans.
  • CSRF protection: Tokens are fetched fresh for each login and automatically
    injected into all state‑changing requests.
  • Cookie files: When using `CookieStore::Persistent`, the JSON file is stored
    in plain text. Ensure the path is in a secure, user‑only accessible location.
  • Input validation: Resource IDs (`no`, `nomor`, `id`) are validated to be > 0
    before any network call, preventing wasteful requests.
  • Redirect limit: The underlying reqwest client is limited to 5 redirects.


=============================================================================
12. COMPLETE EXAMPLES
=============================================================================

12.1 Login, Export Data, Logout

  use librcekunit::{Client, Config};
  use std::collections::HashMap;

  #[tokio::main]
  async fn main() -> Result<(), Box<dyn std::error::Error>> {
      let config = Config::new("https://admin.example.com")
          .with_timeout(60);
      let client = Client::new(config).await?;

      client.login("admin@example.com", "secure123").await?;

      // Export cekunit data as CSV
      let resp = client.cekunit_export("csv", "id", "asc").await?;
      let content = resp.bytes().await?;
      std::fs::write("export.csv", content)?;

      client.logout().await?;
      Ok(())
  }

12.2 Full CRUD for PIC

  let mut data = HashMap::new();
  data.insert("name".into(), "John Doe".into());
  data.insert("phone".into(), "08123456789".into());

  // Create
  let resp = client.pic_store(data.clone()).await?;
  // Update
  data.insert("phone".into(), "08987654321".into());
  let resp = client.pic_update(1, data).await?;
  // Delete
  let resp = client.pic_destroy(1).await?;

12.3 Using Environment Variables

  // .env file: BASE_URL=http://localhost:8080
  let config = Config::from_env().unwrap_or_else(|_| {
      eprintln!("BASE_URL not set, using default");
      Config::new("http://localhost:8080")
  });
  let client = Client::new(config).await?;


